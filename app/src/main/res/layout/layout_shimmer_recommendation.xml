<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1200"
    app:shimmer_base_alpha="1.0"
    app:shimmer_highlight_alpha="0.5"
    app:shimmer_colored="true"
    app:shimmer_base_color="#E0E0E0"
    app:shimmer_highlight_color="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Back Button Placeholder -->
        <View
            android:id="@+id/btn_back_placeholder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_shimmer_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title Placeholder -->
        <View
            android:id="@+id/title_placeholder"
            android:layout_width="280dp"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_shimmer_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_back_placeholder" />

        <!-- Outdoor Section Placeholder -->
        <View
            android:id="@+id/outdoor_title_placeholder"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_shimmer_placeholder"
            app:layout_constraintTop_toBottomOf="@id/title_placeholder" />

        <LinearLayout
            android:id="@+id/outdoor_list_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/outdoor_title_placeholder">
            <include layout="@layout/item_shimmer_recommendation" />
            <include layout="@layout/item_shimmer_recommendation" />
            <include layout="@layout/item_shimmer_recommendation" />
        </LinearLayout>

        <!-- Indoor Section Placeholder -->
        <View
            android:id="@+id/indoor_title_placeholder"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_shimmer_placeholder"
            app:layout_constraintTop_toBottomOf="@id/outdoor_list_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/indoor_title_placeholder">
            <include layout="@layout/item_shimmer_recommendation" />
            <include layout="@layout/item_shimmer_recommendation" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
